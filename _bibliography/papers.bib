 title={Cu/Zn-doped PEO titanium with waveform-tunable bioactivity for dental implants},
 author={Canciani, Elena and Pavarini, Matteo and Darijani, Mohammadamin and Elyasi, Zohreh and Moscatelli, Monica and Scalia, Alessandro and De Giglio, Elvira and Tiainen, Hanna and Rogala, Agnes and Chiesa, Roberto and Boccafoschi, Francesca},
