@misc{darijani2022dmdthesis,
 abbr={DMD Thesis},
 title={Evaluation of Cleaning Efficacy, Instrumentation Time, and Dentin Removal of Manual and Rotary Instrumentation Techniques in Primary Molars: An In Vitro Study},
 author={Darijani, Mohammadamin},
 year={2022},
 howpublished={DMD thesis, Faculty of Dentistry, Kerman University of Medical Sciences},
 abstract={This in vitro study compared manual K-files with the M3 Immature and AF Baby nickel-titanium rotary systems in 90 mesial root canals of extracted mandibular second primary molars. Cleaning efficacy was assessed using residual Indian ink after decalcification and clearing; dentine removal was measured by pre- and post-instrumentation cone-beam computed tomography, and instrumentation time was recorded. No statistically significant differences in cleaning efficacy were detected among the groups in any canal third. Manual K-files removed more dentine than both rotary systems in the coronal and middle thirds. AF Baby preserved more apical dentine than M3 Immature, whereas M3 Immature required less instrumentation time. Both rotary systems were faster than manual instrumentation. These in vitro findings support further clinical evaluation.},
 selected={false},
}
